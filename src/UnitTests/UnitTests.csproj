<Project Sdk="Microsoft.NET.Sdk">
   <PropertyGroup>
      <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
      <IsTestProject>true</IsTestProject>
      <LangVersion>default</LangVersion>
      <AssemblyTitle>KitchenPC.UnitTests</AssemblyTitle>
      <Product>KitchenPC.UnitTests</Product>
      <Company>KitchenPC</Company>
      <OutputPath>bin\$(Configuration)\</OutputPath>
      <RootNamespace>KitchenPC.UnitTests</RootNamespace>
   </PropertyGroup>

   <ItemGroup>
      <PackageReference Include="FluentNHibernate" Version="3.5.0" />
      <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
      <PackageReference Include="MSTest.TestAdapter" Version="4.4.1" />
      <PackageReference Include="MSTest.TestFramework" Version="4.4.1" />
   </ItemGroup>

   <ItemGroup>
      <ProjectReference Include="..\Core\Core.csproj" />
      <ProjectReference Include="..\DB\DB.csproj" />
   </ItemGroup>

   <ItemGroup>
      <Content Include="ModelerData.xml">
         <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </Content>
   </ItemGroup>
</Project>
