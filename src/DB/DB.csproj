<Project Sdk="Microsoft.NET.Sdk">
   <PropertyGroup>
      <LangVersion>default</LangVersion>
      <GenerateDocumentationFile>true</GenerateDocumentationFile>
      <NoWarn>$(NoWarn);1591</NoWarn>
      <AssemblyName>KitchenPC.DB</AssemblyName>
      <AssemblyTitle>KitchenPC.DB</AssemblyTitle>
      <Product>KitchenPC.DB</Product>
      <Description>Database persistence adapter for the KitchenPC recipe engine</Description>
      <Company>KitchenPC</Company>
      <OutputPath>bin\$(Configuration)\</OutputPath>
      <Authors>Mike Christensen</Authors>
      <PackageId>KitchenPC.DB</PackageId>
      <Version>2.1.0</Version>
      <PackageProjectUrl>https://github.com/KitchenPC/core</PackageProjectUrl>
      <RepositoryUrl>https://github.com/KitchenPC/core.git</RepositoryUrl>
      <RepositoryType>git</RepositoryType>
      <PackageLicenseExpression>MIT</PackageLicenseExpression>
      <PackageReadmeFile>README.md</PackageReadmeFile>
      <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
      <PackageTags>recipes;database;nhibernate;postgresql</PackageTags>
      <PublishRepositoryUrl>true</PublishRepositoryUrl>
      <EmbedUntrackedSources>true</EmbedUntrackedSources>
      <IncludeSymbols>true</IncludeSymbols>
      <SymbolPackageFormat>snupkg</SymbolPackageFormat>
      <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
      <RootNamespace>KitchenPC.DB</RootNamespace>
      <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
   </PropertyGroup>

   <ItemGroup>
      <None Include="..\..\LICENSE" Pack="true" PackagePath="/" />
      <None Include="..\..\README.md" Pack="true" PackagePath="/" />
      <PackageReference Include="FluentNHibernate" Version="3.5.0" />
      <!-- Logging 11 no longer supports net8.0; retain the supported dependency for that asset. -->
      <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" Condition="'$(TargetFramework)' == 'net8.0'" />
      <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" Condition="'$(TargetFramework)' != 'net8.0'" />
      <PackageReference Include="NHibernate" Version="5.7.1" />
      <PackageReference Include="Npgsql" Version="10.0.3" />
   </ItemGroup>
   <ItemGroup>
      <ProjectReference Include="..\Core\Core.csproj" />
   </ItemGroup>
</Project>
